[Unit]
Description=ScaleTag Nginx and two-instance HA demo rollout
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/scaletag.env
Environment=SCALETAG_DATA_SOURCE=/ScaleTag/data
Environment=DOCKER_CONFIG=/var/lib/scaletag/docker-config
ExecStart=/usr/local/sbin/scaletag-ha-rollout
# No ExecStop: restarting this unit performs a rolling update and keeps ingress
# and the serving application alive. Docker restarts containers after reboot.
TimeoutStartSec=10min
UMask=0077

[Install]
WantedBy=multi-user.target
