# Production must use HTTPS. Native deployment defaults to loopback.
PUBLIC_ORIGIN=http://127.0.0.1:3000
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Defaults: 10,000 retained polls, 50,000 votes per poll, 20 creations/minute.
MAX_POLLS=10000
MAX_VOTES_PER_POLL=50000
CREATE_LIMIT_PER_MINUTE=20

# Native development defaults to json. HA Compose sets sqlite automatically.
# STORAGE_BACKEND=sqlite
# INSTANCE_ID=app1
# APP_REVISION=development
