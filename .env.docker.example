# Copy to .env for Docker Compose and replace this with your real HTTPS hostname.
PUBLIC_ORIGIN=https://polls.example.com
SCALETAG_PORT=3000
# Default: a Docker-managed named volume. To reuse a host directory, set an absolute path.
# SCALETAG_DATA_SOURCE=/ScaleTag/data
# Match that directory's owner when using a bind mount. Do not run the app as root.
# SCALETAG_UID=1001
# SCALETAG_GID=1001
